Project haruna_db {
  database_type: 'PostgreSQL'
  Note: 'Application schema from the local Supabase instance. auth.users is an external reference stub.'
}

Table auth.users {
  id uuid [pk, not null]

  Note: 'External Supabase Auth table. Only the referenced primary key is shown.'
}

