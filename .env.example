# Environment
ENVIRONMENT=development

# Interactive API docs (/docs, /redoc, /openapi.json). Leave false outside local development.
APP_ENABLE_DOCS=false

# PostgreSQL
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SCHEMA=public

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CORS origins (comma-separated)
API_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# AI service
AI_API_ENDPOINT=
AI_API_KEY=
AI_TRANSLATION_MODEL=