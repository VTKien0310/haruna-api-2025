# Environment
ENVIRONMENT=development

# Interactive API docs (/docs, /redoc, /openapi.json). Leave false outside local development.
APP_ENABLE_DOCS=false

# Logger level for the app.* hierarchy: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
# Default INFO. Leave unset on Fly.io.
LOG_LEVEL=INFO

# Warn when a request takes longer than this many milliseconds. Default 5000.
# Leave unset on Fly.io.
SLOW_REQUEST_THRESHOLD_MS=5000

# PostgreSQL
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SCHEMA=public

# Close pooled connections older than this many seconds on checkout. Default 300.
# Leave unset on Fly.io.
DB_POOL_RECYCLE_SECONDS=300

# asyncpg per-command timeout in seconds, including pool_pre_ping. Default 10.
# Leave unset on Fly.io.
DB_COMMAND_TIMEOUT_SECONDS=10

# asyncpg connection-establishment timeout in seconds. Default 10.
# Leave unset on Fly.io.
DB_CONNECT_TIMEOUT_SECONDS=10

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CORS origins (comma-separated)
API_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# AI service
AI_API_ENDPOINT=
AI_API_KEY=
AI_TRANSLATION_MODEL=